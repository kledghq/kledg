# Kledg configuration. Copy to .env (local) or set in your Vercel project.

# ── Database (required) ─────────────────────────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://kledg:kledg@localhost:5432/kledg"
# Direct connection used for migrations (Neon: the "unpooled" URL).
DATABASE_URL_UNPOOLED="postgresql://kledg:kledg@localhost:5432/kledg"
# Optional connection pool tuning (lib/prisma.ts): connections per server
# instance (default 10) and idle timeout in ms (default 5000 on Vercel, 30000
# elsewhere).
# DATABASE_POOL_MAX=""
# DATABASE_POOL_IDLE_TIMEOUT_MS=""
# TLS to the database: "false" turns it off, "true" forces it. Default: TLS,
# except for localhost, Docker service names and hosts' private networks
# (*.railway.internal, *.flycast, *.internal). See lib/prisma.ts.
# DATABASE_SSL=""
# Row level security (docs/rls.md): "off" (default) or "enforce". With
# enforce, KLEDG_DATABASE_URL is the application role created by
# `pnpm db:rls-role` (it takes precedence over DATABASE_URL), and the owner
# stays in DATABASE_MIGRATION_URL (or DATABASE_URL_UNPOOLED) for migrations.
# KLEDG_RLS=""
# KLEDG_DATABASE_URL=""
# DATABASE_MIGRATION_URL=""

# ── Authentication (required) ───────────────────────────────────────────────
# Random secret, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public URL of your instance. Defaults to the URL the host provides (Vercel,
# Railway, Render, Fly.io, Coolify); required on Clever Cloud, with Docker
# Compose and with `pnpm start`.
BETTER_AUTH_URL="http://localhost:3000"
# Only this email can create the first administrator account on /setup.
ADMIN_EMAIL=""
# Required secret for /setup (open /setup?token=<value>), at least 16
# characters: without it /setup refuses to create the first administrator,
# so nobody can claim a freshly deployed instance. ADMIN_EMAIL alone is not a
# secret. `openssl rand -base64 24`. You can remove it once the administrator exists.
SETUP_TOKEN=""

# ── Email (recommended) ─────────────────────────────────────────────────────
# Resend API key, for password resets and member invitations.
# Without it, emails are printed to the server log.
RESEND_API_KEY=""
# Sender, on a domain verified in Resend.
EMAIL_FROM="Kledg <kledg@example.com>"

# ── Integrations (optional) ─────────────────────────────────────────────────
# Encrypts bank credentials at rest (64 hex chars: `openssl rand -hex 32`).
# Defaults to a key derived from BETTER_AUTH_SECRET.
ENCRYPTION_KEY=""
# Protects /api/cron/* (Vercel sends it automatically when set).
CRON_SECRET=""
# Hosts allowed for company logo URLs (comma separated). Empty: logos must be
# uploaded as images (the PDF renderer never fetches arbitrary URLs).
LOGO_ALLOWED_HOSTS=""

# ── Receipt storage (optional) ──────────────────────────────────────────────
# Where the receipt files Kledg keeps go (docs/configuration.md, "Stockage des
# justificatifs"). Without any of these, they stay in the database. Otherwise
# the first configured wins: Vercel Blob, then S3, then a directory.
# "blob", "s3", "fs" or "postgres" forces the choice.
KLEDG_STORAGE_DRIVER=""
# Vercel Blob, PRIVATE store only (a public store is refused). On Vercel,
# connecting the store to the project sets BLOB_STORE_ID (OIDC access);
# elsewhere set its read-write token.
BLOB_READ_WRITE_TOKEN=""
# S3 compatible bucket (AWS S3, Cloudflare R2, Scaleway, Garage...), private.
# Empty endpoint: AWS, with KLEDG_S3_REGION required. R2:
# https://<account>.r2.cloudflarestorage.com ; Scaleway: https://s3.fr-par.scw.cloud
KLEDG_S3_BUCKET=""
KLEDG_S3_REGION=""
KLEDG_S3_ENDPOINT=""
KLEDG_S3_ACCESS_KEY_ID=""
KLEDG_S3_SECRET_ACCESS_KEY=""
# Server-side encryption header: AES256 (default on AWS), aws:kms (with
# KLEDG_S3_SSE_KMS_KEY_ID) or off (default with an endpoint).
KLEDG_S3_SSE=""
# "true" for path style URLs (default with an endpoint), "false" for virtual host.
KLEDG_S3_FORCE_PATH_STYLE=""
# A directory on a persistent disk (Docker volume). Refused on Vercel.
KLEDG_STORAGE_DIR=""
# "on": move files that are not on the configured storage at server start
# (same as `pnpm receipts:migrate-storage`), then remove it.
KLEDG_STORAGE_MIGRATE=""
# "supplier_invoices": receipts of validated expense reports of a company
# connected to Qonto are stored at Qonto as supplier invoices and Kledg drops
# its copy. Off by default: Qonto lists them as supplier invoices to review
# and cannot delete them (docs/justificatifs-photo.md#qonto).
KLEDG_QONTO_EXPENSE_RECEIPTS=""

# ── Rate limiting (optional) ────────────────────────────────────────────────
# Sign-in, password reset, /setup and OAuth client registration are limited
# per client IP, in the database. Proxy headers are trusted only when
# configured (on Vercel the platform sets them). Behind N reverse proxies that
# append to X-Forwarded-For (nginx, Caddy, Traefik), set TRUST_PROXY_HOPS=N.
# Without it, X-Real-IP and X-Forwarded-For are ignored (a client can forge
# them) and all clients share the same limits.
TRUST_PROXY_HOPS=""
# Alternative: a single header your proxy sets and overwrites with the client
# IP (for example CF-Connecting-IP).
RATE_LIMIT_IP_HEADER=""
# "true" disables these limits (local tests only).
RATE_LIMIT_DISABLED=""

# ── Qonto (optional) ────────────────────────────────────────────────────────
# Qonto API base URL. Leave empty for the real API; set it to use a compatible
# API instead (a proxy, a simulated API for tests).
QONTO_API_URL=""

# ── Updates (optional) ──────────────────────────────────────────────────────
# "true" when your host redeploys on each merge into the default branch of
# your GitHub repository (Fly.io GitHub Action, Clever Cloud or Coolify linked
# to GitHub, Dokploy webhook): the "Mises à jour" page then installs updates
# in two clicks. Automatic on Vercel, Railway and Render; "false" turns it off.
KLEDG_DEPLOYS_FROM_GITHUB=""

# ── Installable app (optional) ──────────────────────────────────────────────
# "true" turns the service worker off: browsers that installed it unregister
# it and delete its caches on their next visit. Read at build time: rebuild
# and redeploy after changing it (docs/self-hosting.md).
NEXT_PUBLIC_DISABLE_SW=""
