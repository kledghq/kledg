# Clever Cloud, Docker application: environment of a Kledg instance.
# Guide: docs/self-hosting.md#clever-cloud
#
# Copy this file outside the repository, fill in the values, then:
#   clever env import < kledg.env
# Never commit the filled-in copy.
#
# The database comes from the linked PostgreSQL add-on: Kledg reads
# POSTGRESQL_ADDON_URI when DATABASE_URL is not set.

# Port Clever Cloud forwards HTTP traffic to (Docker applications: 8080).
PORT=8080
# A deployment fails when this path does not answer 2xx.
CC_HEALTH_CHECK_PATH=/api/health

# Public URL: https://<domain shown by `clever domain`> or your own domain.
BETTER_AUTH_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Only this email can create the administrator account on /setup.
ADMIN_EMAIL=
# openssl rand -base64 24, then open /setup?token=<value>
SETUP_TOKEN=

# Clever Cloud's reverse proxy appends the client address to X-Forwarded-For.
TRUST_PROXY_HOPS=1
# The disk is replaced at each deploy: rely on the add-on's daily backups.
KLEDG_BACKUP=off

# Optional: emails (Resend) and the daily bank sync.
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
