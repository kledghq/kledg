// Better Auth rate limiting (rateLimit.storage = "database"): shared across
// serverless instances, unlike the default in-memory store.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// GitHub connection used by the "Mises à jour" page to update the instance
// (one row per instance, id "default"). The fine-grained token is encrypted
// with the integrations key (lib/crypto/encryption-key.ts) and never sent to
// the browser.
model UpdateConnection {
  id             String    @id @default("default")
  owner          String
  repo           String
  tokenEncrypted String
  tokenLast4     String
  tokenExpiresAt DateTime?
  isFork         Boolean   @default(false)
  defaultBranch  String    @default("main")
  connectedById  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("update_connection")
}

// Companies an AI assistant (OAuth client) or an API key may reach on behalf
// of a user (lib/ai-access). One grant per (user, OAuth client) and per API
// key. No grant means every company the user can access, including future
// ones, so connections made before grants existed keep working. A restricted
// grant only ever narrows the user's own rights: the MCP tools still check
// the user's role in each company. Revoking a consent (trigger in the
// migration), deleting a key, a client, a user or a company removes the
// matching rows.
model AiAccessGrant {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OAuth client (assistant) the grant applies to; exactly one of clientId and apiKeyId is set.
  clientId      String?
  client        OauthClient?           @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  apiKeyId      String?                @unique
  apiKey        Apikey?                @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  /// Every company of the user, including future ones. When false, only `companies`.
  allCompanies  Boolean                @default(true)
  /// How full control runs high-impact tools: "automatic" (executes on the call)
  /// or "validation" (approved by the user in Kledg first). lib/ai-access/access.ts
  executionMode String                 @default("automatic")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  companies     AiAccessGrantCompany[]

  @@unique([userId, clientId])
  @@map("ai_access_grants")
}

model AiAccessGrantCompany {
  grantId   String
  grant     AiAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([grantId, companyId])
  @@index([companyId])
  @@map("ai_access_grant_companies")
}

/// Confirmation of a full control MCP action (lib/mcp/full-control/confirmation.ts).
/// A tool called without confirm returns a dry run and a token; executing the
/// action needs that token, bound to the user, the connection, the tool, the
/// company and the arguments, valid 10 minutes and usable once.
/// No longer written: replaced by McpPendingAction (human approval in Kledg).
/// Kept until a contract migration drops the table.
model McpConfirmation {
  id        String    @id @default(cuid())
  /// SHA-256 of the token handed to the assistant (the token itself is never stored).
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The connection that asked for the preview: "oauth:<clientId>" or "apiKey:<id>".
  caller    String
  tool      String
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// SHA-256 of the normalized arguments of the preview.
  argsHash  String
  expiresAt DateTime
  /// Set when the token is consumed (single use).
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([expiresAt])
  @@map("mcp_confirmations")
}

/// A high-impact MCP full control action waiting for the user's decision in
/// Kledg (lib/mcp/full-control/pending-actions.ts). The assistant can execute
/// it only once approved, with the same arguments, before expiresAt.
model McpPendingAction {
  /// Random, unguessable (it appears in the approval URL).
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The connection that asked: "oauth:<clientId>" or "apiKey:<id>".
  caller     String
  /// OAuth client or API key name, shown on the approval page.
  callerName String?
  tool       String
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Normalized arguments (without actionId) and their SHA-256.
  args       Json
  argsHash   String
  /// The dry run shown to the user before they decide.
  preview    Json
  /// pending, approved, rejected, executing, executed, failed
  status     String    @default("pending")
  expiresAt  DateTime
  decidedAt  DateTime?
  executedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, status])
  @@index([companyId])
  @@index([expiresAt])
  @@map("mcp_pending_actions")
}

/// Guided start of a company ("Démarrer" checklist on the dashboard). The
/// steps are detected from the company's data (lib/onboarding); only the
/// choice to hide the checklist is stored, per company.
model CompanyOnboarding {
  companyId     String    @id
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Set when someone hides the checklist; null while it is shown.
  dismissedAt   DateTime?
  dismissedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("company_onboarding")
}

/// Dashboard of one user in one company: which widgets are shown, in which
/// order and at which size (lib/dashboard). Personal: nobody reads or writes
/// another user's layout. Without a row the user sees the default layout of
/// their role. `layout` is validated by zod on read and write and unknown
/// widget ids are ignored, so widgets come and go without a migration.
model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  /// { "version": 1, "items": [{ "id": "kpi-resultat", "size": "S" }] }
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("dashboard_layouts")
}

/// Personal preferences of one user, following them across devices
/// (lib/appearance). `appearance` holds the chart colours, validated by zod
/// on read and write (lib/appearance/schema.ts); a row that no longer parses
/// reads as the defaults. Without a row the user sees the default colours.
model UserPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  /// { "version": 1, "palette": "custom", "base": "sobre", "custom": { "light": { "revenue": "#0072b2" }, "dark": {} } }
  /// Null when the user never saved colours (they only chose a display mode): the default colours.
  appearance  Json?
  /// 'simple' or 'expert' (lib/appearance/display-mode.ts, check constraint); null until chosen, read as 'expert'.
  displayMode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum TiersKind {
  CUSTOMER // Client (compte collectif 411)
  SUPPLIER // Fournisseur (compte collectif 401)
}

enum InvoiceDirection {
  SALE // Facture émise (journal VE)
  PURCHASE // Facture reçue (journal AC)
}

enum InvoiceSource {
  MANUAL // Saisie dans Kledg
  QONTO // Importée de Qonto
}

enum InvoiceLineNature {
  GOODS // Livraison de biens : TVA exigible à la livraison (CGI art. 269, 2, a)
  SERVICES // Prestation de services : TVA exigible à l'encaissement sauf option pour les débits (CGI art. 269, 2, c)
}

/// A customer or supplier of one company (lib/tiers/manage-tiers.service.ts).
/// Its auxiliary account number is the FEC CompAuxNum of the entry lines it
/// owns (EntryLine.auxiliaryAccountNumber): lettering, the auxiliary balance
/// and the aged balance group lines by that number, so attaching a tiers to
/// existing lines never rewrites a posted line.
model Tiers {
  id                     String    @id @default(cuid())
  companyId              String
  kind                   TiersKind
  name                   String
  siren                  String? // 9 chiffres, contrôle de Luhn (exception La Poste)
  siret                  String? // 14 chiffres, contrôle de Luhn
  vatNumber              String? // Numéro de TVA intracommunautaire
  email                  String?
  addressId              String? // Adresse appartenant à la société (addresses.companyId)
  /// Auxiliary account number (FEC CompAuxNum), unique in the company.
  auxiliaryAccountNumber String
  /// Collective account (401..., 411...) resolved in the fiscal year of the invoice; null: 401 or 411.
  collectiveAccountCode  String?
  /// Expense or revenue account proposed on invoice lines.
  defaultAccountCode     String?
  /// VAT rate proposed on invoice lines, in basis points (2000 = 20 %).
  defaultVatRateBp       Int?
  /// Payment terms of the tiers; null: the company's (Code de commerce art. L441-10).
  paymentTermsDays       Int?
  paymentTermsEndOfMonth Boolean?
  /// Id of the client or supplier at Qonto (idempotent import).
  qontoId                String?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address  Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  invoices Invoice[]

  @@unique([companyId, auxiliaryAccountNumber])
  @@unique([companyId, kind, qontoId])
  @@index([companyId, kind, name])
  @@index([addressId])
  @@map("tiers")
}

/// A purchase or sales invoice of a company, recorded (not issued) by Kledg
/// (lib/invoices). Its amounts are computed from its lines in cents
/// (lib/invoices/amounts.ts); posting creates a draft entry in the purchases
/// (AC) or sales (VE) journal of the fiscal year containing its date and
/// links it here (entryId). Its payment status is derived from the lettering
/// of its tiers line and from the bank payments recorded on it.
model Invoice {
  id                   String           @id @default(cuid())
  companyId            String
  direction            InvoiceDirection
  tiersId              String
  number               String
  issueDate            DateTime
  dueDate              DateTime
  /// UNTDID 1001 (EN 16931 BT-3): 380 invoice, 381 credit note.
  typeCode             String           @default("380")
  currency             String           @default("EUR")
  label                String?
  /// Parties as printed on the document (EN 16931 BT-30 / BT-47 SIREN, BT-31 / BT-48 VAT number), for e-invoicing.
  sellerSiren          String?
  sellerVatNumber      String?
  buyerSiren           String?
  buyerVatNumber       String?
  totalExclTax         Decimal          @db.Decimal(15, 2)
  totalVat             Decimal          @db.Decimal(15, 2)
  totalInclTax         Decimal          @db.Decimal(15, 2)
  /// Draft entry created by posting (null: brouillon). Deleting that draft brings the invoice back to brouillon.
  entryId              String?          @unique
  source               InvoiceSource    @default(MANUAL)
  /// Provider id (Qonto invoice uuid): a re-import updates the same invoice.
  externalId           String?
  externalStatus       String?
  /// Provider reference of the PDF (Qonto attachment uuid): Kledg stores no file, it asks Qonto for a fresh link.
  externalAttachmentId String?
  attachmentFileName   String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  company               Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tiers                 Tiers                 @relation(fields: [tiersId], references: [id], onDelete: Restrict)
  entry                 AccountingEntry?      @relation("InvoiceEntry", fields: [entryId], references: [id], onDelete: SetNull)
  lines                 InvoiceLine[]
  vatBreakdown          InvoiceVatBreakdown[]
  payments              InvoicePayment[]
  managementFeeSale     ManagementFeeBilling? @relation("ManagementFeeSalesInvoice")
  managementFeePurchase ManagementFeeBilling? @relation("ManagementFeePurchaseInvoice")
  simpleModeEntries     SimpleModeEntry[]

  @@unique([companyId, direction, tiersId, number])
  @@unique([companyId, source, externalId])
  @@index([companyId, direction, issueDate])
  @@index([tiersId])
  @@map("invoices")
}

/// One line of an invoice (CGI ann. II art. 242 nonies A, I, 8°: quantity,
/// designation, unit price excluding tax, VAT rate).
model InvoiceLine {
  id           String            @id @default(cuid())
  invoiceId    String
  position     Int
  label        String
  /// Three decimals at most.
  quantity     Decimal           @db.Decimal(15, 3)
  unitPrice    Decimal           @db.Decimal(15, 2)
  /// VAT rate in basis points (2000 = 20 %, 550 = 5,5 %).
  vatRateBp    Int
  /// Quantity x unit price, rounded to the cent (lib/invoices/amounts.ts).
  totalExclTax Decimal           @db.Decimal(15, 2)
  /// Expense or revenue account code, resolved in the fiscal year of the invoice.
  accountCode  String?
  nature       InvoiceLineNature @default(SERVICES)
  /// Purchase of a fixed asset: VAT to 44562.
  fixedAsset   Boolean           @default(false)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// VAT breakdown of an invoice per rate (CGI ann. II art. 242 nonies A, I,
/// 11°; EN 16931 BG-23): computed from the lines for invoices entered in
/// Kledg, taken from the document for imported ones.
model InvoiceVatBreakdown {
  id         String  @id @default(cuid())
  invoiceId  String
  vatRateBp  Int
  baseAmount Decimal @db.Decimal(15, 2)
  vatAmount  Decimal @db.Decimal(15, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, vatRateBp])
  @@map("invoice_vat_breakdowns")
}

/// A bank payment recorded on an invoice: the line of a validated entry
/// reconciled with a bank transaction, on the invoice's tiers account, on the
/// opposite side. A line pays one invoice; the invoice is lettered with its
/// payments once they cover it (lib/invoices/invoice-payments.service.ts).
model InvoicePayment {
  id                 String   @id @default(cuid())
  invoiceId          String
  entryLineId        String   @unique
  amount             Decimal  @db.Decimal(15, 2)
  /// Draft entry moving the VAT of an encaissement-based sale from 44574 to 44571 (CGI art. 269, 2, c).
  vatTransferEntryId String?
  createdAt          DateTime @default(now())

  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  entryLine        EntryLine        @relation(fields: [entryLineId], references: [id], onDelete: Cascade)
  vatTransferEntry AccountingEntry? @relation("InvoicePaymentVatTransfer", fields: [vatTransferEntryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([vatTransferEntryId])
  @@map("invoice_payments")
}

enum ExpenseClaimantKind {
  EMPLOYEE // Salarié : compte 421 par défaut
  DIRIGEANT // Dirigeant non associé : compte 467 par défaut
  ASSOCIE // Associé (dirigeant ou non) : compte courant 455 par défaut
}

enum ExpenseReportStatus {
  DRAFT // Brouillon : modifiable par son auteur
  SUBMITTED // Soumise : attend la validation
  VALIDATED // Validée : prête à comptabiliser (comptabilisée et remboursée se déduisent de l'écriture)
}

enum ExpenseLineKind {
  EXPENSE // Dépense avec un justificatif
  MILEAGE // Indemnité kilométrique (barème, sans TVA)
}

enum ExpenseReceiptKind {
  NONE // Aucun justificatif
  RECEIPT // Ticket ou facture simplifiée (150 € HT au plus)
  INVOICE // Facture au nom de la société
}

/// A person the company reimburses expenses to: an employee, a dirigeant or
/// an associé, linked to a Person of the company or to a member (user).
/// Its account is credited with what the company owes (421, 455, 467 by
/// kind, or the code set here) with its auxiliary account number, so that
/// lettering pairs a report with its reimbursement
/// (lib/expense-reports/manage-expense-claimants.service.ts).
model ExpenseClaimant {
  id                     String              @id @default(cuid())
  companyId              String
  kind                   ExpenseClaimantKind
  name                   String
  personId               String?
  userId                 String?
  /// Account credited by the reports (421..., 455..., 467...); null: the default of the kind.
  accountCode            String?
  /// Auxiliary account number (FEC CompAuxNum) on the credited line, unique in the company.
  auxiliaryAccountNumber String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  person  Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  reports ExpenseReport[]

  @@unique([companyId, auxiliaryAccountNumber])
  @@unique([companyId, userId])
  @@unique([companyId, personId])
  @@index([personId])
  @@index([userId])
  @@map("expense_claimants")
}

/// An expense report (note de frais) of one claimant for one period
/// (lib/expense-reports). Its amounts are computed from its lines in cents
/// (lib/expense-reports/amounts.ts). Brouillon, soumise and validée are
/// stored; comptabilisée (entryId set) and remboursée (the claimant line of
/// the entry is lettered) are derived.
model ExpenseReport {
  id             String              @id @default(cuid())
  companyId      String
  claimantId     String
  /// NDF-0001, NDF-0002... unique in the company.
  number         String
  label          String?
  periodStart    DateTime
  periodEnd      DateTime
  status         ExpenseReportStatus @default(DRAFT)
  /// What the company owes the claimant (TTC of the expenses plus the mileage allowances).
  totalInclTax   Decimal             @db.Decimal(15, 2)
  /// VAT the company recovers (44566).
  recoverableVat Decimal             @db.Decimal(15, 2)
  /// Charges: totalInclTax minus recoverableVat.
  totalExpense   Decimal             @db.Decimal(15, 2)
  createdById    String?
  submittedAt    DateTime?
  submittedById  String?
  validatedAt    DateTime?
  validatedById  String?
  /// Why a validator sent the report back to its author.
  returnNote     String?
  /// Draft entry created by posting (null: not posted). Deleting that draft brings the report back to validée.
  entryId        String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  claimant ExpenseClaimant  @relation(fields: [claimantId], references: [id], onDelete: Restrict)
  entry    AccountingEntry? @relation("ExpenseReportEntry", fields: [entryId], references: [id], onDelete: SetNull)
  lines    ExpenseLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([claimantId])
  @@map("expense_reports")
}

/// One expense of a report, or one trip paid by the mileage scale.
model ExpenseLine {
  id                  String             @id @default(cuid())
  reportId            String
  position            Int
  kind                ExpenseLineKind    @default(EXPENSE)
  date                DateTime
  supplierName        String?
  label               String
  /// Category key of lib/expense-reports/categories.ts (default account and VAT rule).
  category            String
  /// Expense account; null: the default account of the category.
  accountCode         String?
  amountInclTax       Decimal            @db.Decimal(15, 2)
  /// VAT rate in basis points (2000 = 20 %).
  vatRateBp           Int                @default(0)
  /// VAT shown on the receipt.
  vatAmount           Decimal            @default(0) @db.Decimal(15, 2)
  /// Part of vatAmount the company recovers (lib/expense-reports/vat-recovery.ts).
  recoverableVat      Decimal            @default(0) @db.Decimal(15, 2)
  receiptKind         ExpenseReceiptKind @default(NONE)
  /// A receipt already in Kledg (a Qonto attachment): Kledg stores no file.
  receiptAttachmentId String?
  /// Reference of a paper or emailed receipt kept by the company.
  receiptReference    String?
  /// Mileage: CAR, MOTORCYCLE or MOPED, fiscal power, electric (+20 %), distance.
  vehicleType         String?
  fiscalPower         Int?
  electric            Boolean            @default(false)
  distanceKm          Int?
  /// Kilometres of the same vehicle already counted in the year before this trip (scale bands are annual).
  priorDistanceKm     Int?
  /// Year of the mileage scale applied.
  scaleYear           Int?

  report            ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  receiptAttachment Attachment?   @relation(fields: [receiptAttachmentId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([receiptAttachmentId])
  @@map("expense_lines")
}

/// Automatic category of expense lines: a keyword found in the supplier name
/// or the label gives the category (and optionally the account). Highest
/// priority first (lib/expense-reports/category-rules.ts).
model ExpenseCategoryRule {
  id          String   @id @default(cuid())
  companyId   String
  keyword     String
  category    String
  accountCode String?
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("expense_category_rules")
}

/// How often a recurring budget item falls due, from its first month
/// (lib/budgets/recurring.ts).
enum BudgetFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Budget of a fiscal year (docs/budget.md): one per fiscal year, compared
/// with the validated entries of that year (lib/budgets/budget-report.service.ts).
model Budget {
  id           String   @id @default(cuid())
  companyId    String
  fiscalYearId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// On (fiscalYearId, companyId): the fiscal year is always one of the budget's company.
  fiscalYear FiscalYear   @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Cascade)
  lines      BudgetLine[]

  /// One budget per fiscal year (a fiscal year belongs to one company).
  @@unique([fiscalYearId, companyId])
  @@index([companyId])
  @@map("budgets")
}

/// A line of a budget: the class 6 or 7 accounts whose number starts with
/// `accountPrefix` (an account goes to the line with the longest matching
/// prefix). A prefix, not an account id: accounts belong to one fiscal year.
model BudgetLine {
  id            String   @id @default(cuid())
  budgetId      String
  accountPrefix String
  label         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  budget                Budget                 @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  amounts               BudgetLineAmount[]
  recurringItems        BudgetRecurringItem[]
  /// Subscriptions added to the budget on this line (lib/subscriptions).
  subscriptionDecisions SubscriptionDecision[]

  @@unique([budgetId, accountPrefix])
  @@map("budget_lines")
}

/// Amount entered for one calendar month (`yyyy-mm`) of a budget line.
model BudgetLineAmount {
  id     String  @id @default(cuid())
  lineId String
  month  String
  amount Decimal @db.Decimal(15, 2)

  line BudgetLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, month])
  @@map("budget_line_amounts")
}

/// A recurring amount of a budget line (subscription, rent, insurance),
/// expanded into the months of the fiscal year from `startMonth` to
/// `endMonth` (inclusive, `yyyy-mm`), added to the amounts entered by month.
model BudgetRecurringItem {
  id         String          @id @default(cuid())
  lineId     String
  label      String
  amount     Decimal         @db.Decimal(15, 2)
  frequency  BudgetFrequency
  startMonth String
  endMonth   String?
  position   Int             @default(0)

  line BudgetLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("budget_recurring_items")
}

enum SubscriptionCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionDecisionStatus {
  CONFIRMED // Abonnement reconnu par l'utilisateur
  IGNORED // Faux positif ou paiement récurrent hors abonnement (salaire, virement interne)
}

/// What a user decided about a detected subscription (lib/subscriptions,
/// docs/abonnements.md). Detection itself is recomputed from the bank lines
/// at each read and never stored: only decisions are. A decision is attached
/// to the detected series of the same counterparty key and cadence whose
/// amount is closest to referenceAmount (lib/subscriptions/detect.ts,
/// matchDecisions), so it survives a price change.
model SubscriptionDecision {
  id              String                     @id @default(cuid())
  companyId       String
  /// Normalized counterparty (counterpartyKey in lib/subscriptions/detect.ts).
  counterpartyKey String
  cadence         SubscriptionCadence
  /// Typical amount of the series when the decision was taken.
  referenceAmount Decimal                    @db.Decimal(15, 2)
  status          SubscriptionDecisionStatus
  /// Budget line the subscription was last added to as a recurring item.
  budgetLineId    String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)

  @@unique([companyId, counterpartyKey, cadence, referenceAmount], map: "subscription_decisions_identity_key")
  @@index([budgetLineId])
  @@map("subscription_decisions")
}

enum ManagementFeePricing {
  COST_PLUS // Charges de la holding sur la période, majorées d'une marge
  FIXED // Montant forfaitaire hors taxes par période
}

enum ManagementFeeAllocationKey {
  EQUAL // Parts égales (au prorata des jours de présence dans la convention)
  REVENUE // Au prorata du chiffre d'affaires (comptes 70) de chaque filiale
  CUSTOM // Pourcentages fixés par la convention (total 100 %)
}

/// A management fee agreement (convention de prestations de services, frais
/// de gestion) of a holding with some of its subsidiaries
/// (lib/management-fees, docs/frais-de-gestion.md). companyId is the holding:
/// the company recorded as shareholder (Shareholder.companyShareholderId) of
/// each subsidiary. Rates are integer basis points (500 = 5 %).
model ManagementFeeConvention {
  id                      String                     @id @default(cuid())
  companyId               String
  label                   String
  pricing                 ManagementFeePricing       @default(COST_PLUS)
  /// Mark-up on the cost base (cost plus, OECD TPG chapter VII), in basis points.
  markupBp                Int                        @default(500)
  /// Part of the cost pool spent on services to the subsidiaries (the rest: shareholder activity, not chargeable).
  costShareBp             Int                        @default(10000)
  /// Charge accounts in the cost pool, by prefix (["6"]: every class 6 account).
  costAccountPrefixes     String[]
  /// Charge accounts left out of the pool, by prefix (income tax, penalties, financial and exceptional charges).
  excludedAccountPrefixes String[]
  /// FIXED pricing: amount excluding tax of one period for all the subsidiaries.
  fixedAmount             Decimal?                   @db.Decimal(15, 2)
  allocationKey           ManagementFeeAllocationKey @default(EQUAL)
  /// VAT rate of the invoices, in basis points (2000 = 20 %).
  vatRateBp               Int                        @default(2000)
  /// Revenue account of the holding's sales invoices (706 prestations de services).
  revenueAccountCode      String                     @default("706")
  /// Expense account proposed on the subsidiaries' purchase invoices.
  expenseAccountCode      String                     @default("6226")
  /// Series of the sales invoice numbers: <prefix>-<year>-<sequence>.
  invoicePrefix           String                     @default("FG")
  startDate               DateTime
  endDate                 DateTime?
  notes                   String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subsidiaries ManagementFeeSubsidiary[]
  billings     ManagementFeeBilling[]

  @@index([companyId])
  @@map("management_fee_conventions")
}

/// A subsidiary party to a convention, with its custom share and the days it
/// is party to it (signature, exit): a subsidiary present part of a period
/// gets a share prorated by days.
model ManagementFeeSubsidiary {
  id             String    @id @default(cuid())
  conventionId   String
  subsidiaryId   String
  /// CUSTOM key: share in basis points (the shares of a convention add up to 10000).
  sharePercentBp Int?
  startDate      DateTime?
  endDate        DateTime?
  position       Int       @default(0)

  convention ManagementFeeConvention @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  subsidiary Company                 @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)

  @@unique([conventionId, subsidiaryId])
  @@index([subsidiaryId])
  @@map("management_fee_subsidiaries")
}

/// The fee of one subsidiary for one period, as invoiced: the amounts of the
/// holding's sales invoice (computed once, by lib/management-fees/compute.ts,
/// with the rounding of lib/invoices/amounts.ts) and the draft purchase
/// invoice proposed to the subsidiary. companyId is the holding.
model ManagementFeeBilling {
  id                String   @id @default(cuid())
  companyId         String
  conventionId      String
  subsidiaryId      String
  periodStart       DateTime
  periodEnd         DateTime
  amountExclTax     Decimal  @db.Decimal(15, 2)
  vatRateBp         Int
  vatAmount         Decimal  @db.Decimal(15, 2)
  amountInclTax     Decimal  @db.Decimal(15, 2)
  /// How the amount was computed (cost pool, mark-up, key and weights), for the transfer pricing file.
  details           Json
  salesInvoiceId    String?  @unique
  purchaseInvoiceId String?  @unique
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company                 @relation("ManagementFeeBillingHolding", fields: [companyId], references: [id], onDelete: Cascade)
  convention      ManagementFeeConvention @relation(fields: [conventionId], references: [id], onDelete: NoAction)
  subsidiary      Company                 @relation("ManagementFeeBillingSubsidiary", fields: [subsidiaryId], references: [id], onDelete: Cascade)
  salesInvoice    Invoice?                @relation("ManagementFeeSalesInvoice", fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  purchaseInvoice Invoice?                @relation("ManagementFeePurchaseInvoice", fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  @@unique([conventionId, subsidiaryId, periodStart, periodEnd])
  @@index([companyId])
  @@index([subsidiaryId])
  @@map("management_fee_billings")
}

enum ProvisionCategory {
  RISK_CHARGE // Provisions pour risques et charges (comptes 151 et 152)
  FIXED_ASSET // Dépréciations des immobilisations (29)
  INVENTORY // Dépréciations des stocks et en-cours (39)
  RECEIVABLE // Dépréciations des comptes de tiers (49)
  SECURITY // Dépréciations des valeurs mobilières de placement (59)
}

enum ProvisionNature {
  OPERATING // Dotations 681, reprises 781
  FINANCIAL // Dotations 686, reprises 786
  EXCEPTIONAL // Dotations 687, reprises 787
}

/// A provision for risks and charges (PCG art. 322-1 et seq.) or an
/// impairment of an asset (PCG art. 214-15 et seq.), followed from one
/// closing to the next (lib/provisions, docs/provisions-et-subventions.md).
/// Both are an allowance: a credit balance account (15, 29, 39, 49, 59)
/// adjusted at each closing against a dotation (68) or a reprise (78).
/// The balance required at each closing is a ProvisionAssessment; the
/// movement is proposed as a draft entry the user validates.
model Provision {
  id            String            @id @default(cuid())
  companyId     String
  category      ProvisionCategory
  label         String
  /// Object of the provision and how it is estimated (PCG art. 322-1: nettement précisée quant à son objet).
  justification String
  /// Allowance account credited by a dotation (15xx, 29xx, 39x, 49x, 59x).
  accountCode   String
  nature        ProvisionNature   @default(OPERATING)
  /// Deductible for corporate tax (CGI art. 39, 1-5°); a non-deductible one is added back on the tax return.
  taxDeductible Boolean           @default(true)
  /// False for an impairment of goodwill (fonds commercial), which is never reversed (PCG art. 214-19).
  reversible    Boolean           @default(true)
  fixedAssetId  String?
  /// Auxiliary account number (or account) of the doubtful customer of a receivable impairment.
  tiersCode     String?
  /// Day of the event that gave rise to it (litigation served, overdue invoice, loss of value noticed).
  openedOn      DateTime
  /// Day the risk ended or the asset left the books: no assessment is expected after it.
  closedOn      DateTime?
  /// Balance already booked before Kledg followed it (opening entries of a company migrated to Kledg).
  carriedAmount Decimal           @default(0) @db.Decimal(15, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fixedAsset  FixedAsset?           @relation(fields: [fixedAssetId], references: [id], onDelete: SetNull)
  assessments ProvisionAssessment[]

  /// Target of the composite foreign key of the assessments (same company).
  @@unique([id, companyId])
  @@index([companyId])
  @@index([fixedAssetId])
  @@map("provisions")
}

/// The balance a provision or impairment must show at the closing of one
/// fiscal year, and the entry booking the movement to reach it. The
/// movement is read from the entry's lines, so a draft the user edits or a
/// contre-passation is taken into account.
model ProvisionAssessment {
  id           String   @id @default(cuid())
  companyId    String
  provisionId  String
  fiscalYearId String
  /// Balance required at the closing date of the fiscal year.
  amount       Decimal  @db.Decimal(15, 2)
  /// Impairment of a fixed asset: its current value (valeur actuelle, the higher of market value and value in use), when the amount was computed from it.
  currentValue Decimal? @db.Decimal(15, 2)
  /// How the amount was estimated (pièce justificative of the closing).
  basis        String?
  /// Entry of the dotation or reprise of this closing (draft until the user validates it).
  entryId      String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provision  Provision        @relation(fields: [provisionId, companyId], references: [id, companyId], onDelete: Cascade)
  fiscalYear FiscalYear       @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Cascade)
  entry      AccountingEntry? @relation("ProvisionAssessmentEntry", fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([provisionId, fiscalYearId])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("provision_assessments")
}

enum InvestmentGrantSpreading {
  ASSET // Same rhythm as the depreciation of the financed fixed asset (PCG art. 312-1)
  LINEAR // Linear over a duration, for a depreciable asset not followed in Kledg
  INALIENABILITY // Non-depreciable asset: over the years it is inalienable
  TENTHS // Non-depreciable asset without inalienability clause: one tenth a year
}

/// An investment grant (subvention d'investissement) recorded in equity
/// (131) and transferred to the result (139 to 747) over the life of what
/// it financed (PCG art. 312-1, CGI art. 42 septies).
model InvestmentGrant {
  id                  String                   @id @default(cuid())
  companyId           String
  label               String
  grantor             String?
  amount              Decimal                  @db.Decimal(15, 2)
  /// Day the grant was awarded: the first fiscal year of its transfer.
  grantedOn           DateTime
  spreading           InvestmentGrantSpreading
  fixedAssetId        String?
  /// LINEAR: duration of the depreciation; INALIENABILITY: years of inalienability.
  durationYears       Int?
  accountCode         String                   @default("131")
  transferAccountCode String                   @default("139")
  incomeAccountCode   String                   @default("747")
  /// Part already transferred to the result before Kledg followed the grant.
  carriedAmount       Decimal                  @default(0) @db.Decimal(15, 2)
  notes               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// RESTRICT: the transfer follows the asset's depreciation, the grant is changed before the asset is deleted.
  fixedAsset FixedAsset?               @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)
  transfers  InvestmentGrantTransfer[]

  /// Target of the composite foreign key of the transfers (same company).
  @@unique([id, companyId])
  @@index([companyId])
  @@index([fixedAssetId])
  @@map("investment_grants")
}

/// The entry transferring the share of a grant of one fiscal year to the
/// result (debit 139, credit 747). The amount is read from the entry.
model InvestmentGrantTransfer {
  id           String   @id @default(cuid())
  companyId    String
  grantId      String
  fiscalYearId String
  entryId      String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grant      InvestmentGrant  @relation(fields: [grantId, companyId], references: [id, companyId], onDelete: Cascade)
  fiscalYear FiscalYear       @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Cascade)
  entry      AccountingEntry? @relation("InvestmentGrantTransferEntry", fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([grantId, fiscalYearId])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("investment_grant_transfers")
}

/// The approval of a fiscal year's accounts (approbation des comptes) and
/// their filing with the greffe (lib/approval, docs/approbation-des-comptes.md).
/// The books, the company record and the shareholders give the figures and
/// the names; `details` holds what only the user knows (meeting, officers,
/// attendance, votes, choices), validated by ApprovalDetailsSchema
/// (lib/approval/schemas.ts). approvedOn and filedOn are copied out of it so
/// the deadline calendar (lib/deadlines) reads them in one query.
model AccountsApproval {
  id           String    @id @default(cuid())
  companyId    String
  fiscalYearId String
  details      Json
  /// Day the accounts were approved (decision, or filing worth approval).
  approvedOn   DateTime?
  /// Day the approved accounts were filed with the greffe.
  filedOn      DateTime?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// On (fiscalYearId, companyId): the fiscal year is always one of the company's.
  fiscalYear FiscalYear @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Cascade)

  /// One approval per fiscal year.
  @@unique([fiscalYearId, companyId])
  @@index([companyId])
  @@map("accounts_approvals")
}

/// An entry confirmed in simple mode (docs/categories-simples.md): the plain
/// language category the user chose for a bank transaction, the answers to
/// its question, the note for the accountant and whether the accountant must
/// validate it. The entry itself goes through the entry and reconciliation
/// services like any other; this row only records where it came from, so the
/// accountant finds it ("Saisies du mode simple") and the history of a
/// counterparty feeds the next suggestions. Deleted with its entry (a draft
/// removed by undoing the reconciliation).
model SimpleModeEntry {
  id                String   @id @default(cuid())
  companyId         String
  entryId           String   @unique
  bankTransactionId String?
  /// Category of the catalogue (lib/simple/categories.ts); null when a transaction rule chose the lines.
  categoryId        String?
  /// Transaction rule applied, when the user confirmed a rule's suggestion.
  ruleId            String?
  /// Answers to the category's question, { questionId: answerId }.
  answers           Json?
  note              String?
  /// Normalized counterparty (lib/subscriptions/detect.ts counterpartyKey): the history key.
  counterpartyKey   String
  /// The entry was left a draft for the accountant (company setting at confirmation).
  needsReview       Boolean  @default(false)
  /// Transaction rule created or updated from this choice after repeated identical choices.
  learnedRuleId     String?
  /// web or mcp.
  source            String   @default("web")
  /// Fixed asset created with the entry (durable equipment); null once the asset is deleted.
  fixedAssetId      String?  @unique
  /// Sales invoice a customer payment confirmed in simple mode pays; recorded on it (invoice_payments) once the entry is validated. The invoice cannot be deleted while it is named here.
  invoiceId         String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entry           AccountingEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  fixedAsset      FixedAsset?      @relation(fields: [fixedAssetId], references: [id], onDelete: SetNull)
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: NoAction)

  @@index([companyId, counterpartyKey])
  @@index([bankTransactionId])
  @@index([invoiceId])
  @@map("simple_mode_entries")
}

/// A VAT return the user says was filed on impots.gouv.fr (docs/declarations-tva.md):
/// Kledg prepares the return, the user files it and records here the day
/// and the amounts declared. The next period's checks read it: the payment
/// booked on 4455 against the amount due, the credit carried forward
/// (CA3 line 22, CA12 line 24) against the credit declared. Kledg never
/// files a return itself.
model VatReturnFiling {
  id           String   @id @default(cuid())
  companyId    String
  /// CA3 or CA12.
  form         String
  /// yyyy-mm (monthly CA3), yyyy-Tn (quarterly CA3) or yyyy (CA12), as the deadline calendar keys them.
  periodKey    String
  periodStart  DateTime
  periodEnd    DateTime
  filedOn      DateTime
  /// Amount paid with the return (CA3 line 28, CA12 line 33), 0 for a credit.
  amountDue    Decimal  @db.Decimal(15, 2)
  /// Credit carried forward (CA3 line 27, CA12 line 51), 0 when VAT is due.
  creditAmount Decimal  @db.Decimal(15, 2)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// One record per period of a company.
  @@unique([companyId, periodKey])
  @@index([companyId])
  @@map("vat_return_filings")
}

/// The impôt sur les sociétés of a fiscal year (docs/impot-societes.md):
/// Kledg prepares the tax result worksheet and the IS from the books; this
/// row keeps what the books cannot tell (answers to the reduced rate
/// questions, deficits carried forward, manual lines, acomptes paid) and,
/// once the user filed the return on impots.gouv.fr, what was declared.
/// The filed amounts drive the acomptes of the next fiscal year (CGI art.
/// 1668). Kledg never files a return itself.
model CorporateTaxReturn {
  id                   String    @id @default(cuid())
  companyId            String
  fiscalYearId         String
  /// Capital entièrement libéré (CGI art. 219, I, b); null: not answered.
  capitalPaidUp        Boolean?
  /// Capital held for 75 % at least by natural persons, directly or through companies meeting the same conditions; null: not answered.
  naturalPersons75     Boolean?
  /// Deficits carried forward available at the start of the year (CGI art. 209, I); null: derived from the previous year.
  deficitsOpening      Decimal?  @db.Decimal(15, 2)
  /// Lines the books cannot tell, JSON array of { id, kind: reintegration | deduction | credit, label, amountCents }.
  manualLines          Json      @default("[]")
  /// Acomptes paid for this fiscal year (2571), JSON array of { number, paidOn, amountCents }.
  acomptesPaid         Json      @default("[]")
  /// Filed on impots.gouv.fr: all five set, or none.
  filedOn              DateTime?
  /// Résultat fiscal avant imputation des déficits (2033-B 352/354, 2058-A XI/XJ): negative for a deficit.
  resultBeforeDeficits Decimal?  @db.Decimal(15, 2)
  /// Déficits antérieurs imputés (2033-B 360, 2058-A XL).
  deficitsImputed      Decimal?  @db.Decimal(15, 2)
  /// Impôt sur les sociétés at the rates of art. 219, before credits and contribution sociale.
  corporateTax         Decimal?  @db.Decimal(15, 2)
  /// The 15 % reduced rate was applied.
  reducedRate          Boolean?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// On (fiscalYearId, companyId): the fiscal year is always one of the row's company.
  fiscalYear FiscalYear @relation(fields: [fiscalYearId, companyId], references: [id, companyId], onDelete: Cascade)

  /// One row per fiscal year (a fiscal year belongs to one company).
  @@unique([fiscalYearId, companyId])
  @@index([companyId])
  @@map("corporate_tax_returns")
}
