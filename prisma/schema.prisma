// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CompanyLegalType {
  SARL // Société à Responsabilité Limitée
  SAS // Société par Actions Simplifiée
  SA // Société Anonyme
  EURL // Entreprise Unipersonnelle à Responsabilité Limitée
  SNC // Société en Nom Collectif
  SCS // Société en Commandite Simple
  SCA // Société en Commandite par Actions
  SASU // Société par actions simplifiée unipersonnelle (an SAS with one shareholder)
  SCI // Société civile immobilière
  SELARL // Société d'exercice libéral à responsabilité limitée
  SELAS // Société d'exercice libéral par actions simplifiée
  EI // Entrepreneur individuel
}

/// A postal address owned by one company (companyId): only that company
/// searches, reads and attaches it (lib/addresses/manage-addresses.service.ts).
/// Every link to it (the company's own address and headquarters, its
/// establishments, its persons) belongs to the owning company; an address
/// no link uses any more is deleted with the change that let it go.
model Address {
  id         String   @id @default(cuid())
  companyId  String // Société propriétaire de l'adresse
  street     String // Rue et numéro
  street2    String? // Complément d'adresse (appartement, étage, etc.)
  postalCode String // Code postal
  city       String // Ville
  country    String   @default("FR") // Pays (code ISO, ex: "FR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations - toutes les entités qui utilisent cette adresse
  company               Company         @relation("CompanyOwnedAddresses", fields: [companyId], references: [id], onDelete: Cascade)
  companies             Company[]       @relation("CompanyAddress")
  companiesHeadquarters Company[]       @relation("CompanyHeadquartersAddress")
  establishments        Establishment[]
  persons               Person[]
  tiers                 Tiers[]

  @@index([companyId])
  @@index([postalCode, city])
  @@index([country])
  @@map("addresses")
}

model Company {
  id                         String            @id @default(cuid())
  name                       String
  slug                       String            @unique // Identifiant lisible dans les URL (/atelier-lumen/...), modifiable
  siren                      String            @unique // SIREN (9 chiffres) - identifie l'entreprise
  addressId                  String? // Référence vers l'adresse réutilisable
  phone                      String?
  email                      String?
  logo                       String?
  foundationDate             DateTime? // Date de création de l'entreprise
  closingDay                 Int? // Jour de clôture des exercices (1-31)
  closingMonth               Int? // Mois de clôture des exercices (1-12)
  vatRegime                  String? // Régime de TVA (normal, simplified, mini_real, franchise, real)
  isVatExempt                Boolean           @default(false) // Indique si l'entreprise est exonérée de TVA
  vatExemptReason            String? // Raison de l'exonération de TVA
  vatNumber                  String? // Numéro de TVA intracommunautaire
  corporateTaxRegime         String? // Régime d'IS (normal, simplified, micro)
  legalType                  CompanyLegalType? // Type juridique de la société (SARL, SAS, SA, etc.)
  legalForm                  String? // Forme juridique détaillée (pour les déclarations fiscales)
  color                      String? // Couleur pour les graphiques (format hex: #RRGGBB)
  sector                     String? // Secteur d'activité (ex: "tech", "retail", "services", "manufacturing", "real-estate", "finance", "healthcare", "other")
  isHolding                  Boolean           @default(false) // Indique si l'entreprise est une holding pure (sans activité opérationnelle)
  // Informations sur le capital social
  totalShares                Int? // Nombre total de parts/actions
  shareNominalValue          Decimal?          @db.Decimal(15, 2) // Valeur nominale d'une part (en euros)
  shareCapital               Decimal?          @db.Decimal(15, 2) // Capital social total (en euros) - peut être calculé ou saisi manuellement
  // Informations légales pour les déclarations fiscales
  headquartersAddressId      String? // Référence vers l'adresse du siège social
  activityCode               String? // Code APE/NAF
  taxOffice                  String? // Centre des impôts compétent
  // Configuration pour le rapprochement bancaire
  defaultBankAccountCode     String? // Code du compte bancaire par défaut à utiliser pour le rapprochement (classe 5, ex: 512000). Résolu dynamiquement selon l'exercice fiscal actif.
  /// Payment terms of the aged balance (lib/reports/third-parties/aged-balance.ts):
  /// days after the invoice date, or days then end of month. Code de commerce
  /// art. L441-10: 30 days by default, at most 60 days, or 45 days end of month
  /// (checked by the database, migration 20261018090000).
  paymentTermsDays           Int               @default(30)
  paymentTermsEndOfMonth     Boolean           @default(false)
  /// What the tax and legal deadline calendar needs and Kledg cannot infer
  /// (VAT filing day, quarterly CA3, IS and CFE acomptes...): JSON validated by
  /// DeadlineSettingsSchema (lib/deadlines/settings.ts); null: the defaults.
  deadlineSettings           Json?
  /// VAT on services is due when the price is received (CGI art. 269, 2, c);
  /// a company may opt to pay it on debits (invoice). False: sales invoices of
  /// services post their VAT to 44574 "TVA collectée en attente d'encaissement"
  /// until paid (lib/invoices/posting-plan.ts).
  servicesVatOnDebits        Boolean           @default(false)
  /// Simple mode (docs/categories-simples.md): whether the entries a user
  /// confirms in simple mode stay drafts until the accountant validates them.
  /// Null: the default, on when the company has a member with the accountant
  /// role (lib/simple/simple-mode-settings.service.ts).
  simpleModeAccountantReview Boolean?
  /// Set when an instance administrator archives the company: read-only and
  /// hidden from the lists (lib/companies/archive-company.service.ts). A company
  /// holding validated entries or a closed fiscal year is archived, never deleted.
  archivedAt                 DateTime?
  archivedById               String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  // Relations
  address                    Address?                    @relation("CompanyAddress", fields: [addressId], references: [id], onDelete: SetNull)
  headquartersAddress        Address?                    @relation("CompanyHeadquartersAddress", fields: [headquartersAddressId], references: [id], onDelete: SetNull)
  ownedAddresses             Address[]                   @relation("CompanyOwnedAddresses") // Adresses appartenant à la société
  shareholders               Shareholder[]               @relation("CompanyShareholders") // Actionnaires de cette société
  shareholdings              Shareholder[]               @relation("CompanyAsShareholder") // Sociétés dont cette société est actionnaire
  accounts                   Account[]
  journals                   Journal[]
  accountingEntries          AccountingEntry[]
  bankConnections            BankConnection[]
  integrations               Integration[]
  importJobs                 ImportJob[]
  fiscalYears                FiscalYear[]
  fixedAssets                FixedAsset[]
  taxRegimeHistory           TaxRegimeHistory[]
  transactionRules           TransactionRule[]
  auditLogs                  AuditLog[]
  persons                    Person[] // Through PersonalSalary
  attachments                Attachment[]
  establishments             Establishment[] // Établissements (plusieurs SIRET par entreprise)
  balanceSheetLineConfigs    BalanceSheetLineConfig[]
  incomeStatementLineConfigs IncomeStatementLineConfig[]
  fixedAssetDepreciations    FixedAssetDepreciation[]
  organization               Organization?               @relation("CompanyOrganization")
  aiAccessGrants             AiAccessGrantCompany[]
  mcpConfirmations           McpConfirmation[]
  mcpPendingActions          McpPendingAction[]
  onboarding                 CompanyOnboarding?
  dashboardLayouts           DashboardLayout[]
  tiers                      Tiers[]
  invoices                   Invoice[]
  expenseClaimants           ExpenseClaimant[]
  expenseReports             ExpenseReport[]
  expenseCategoryRules       ExpenseCategoryRule[]
  budgets                    Budget[]
  subscriptionDecisions      SubscriptionDecision[]
  managementFeeConventions   ManagementFeeConvention[]
  managementFeeSubsidiaryOf  ManagementFeeSubsidiary[]
  managementFeeBillings      ManagementFeeBilling[]      @relation("ManagementFeeBillingHolding")
  managementFeeBilled        ManagementFeeBilling[]      @relation("ManagementFeeBillingSubsidiary")
  provisions                 Provision[]
  provisionAssessments       ProvisionAssessment[]
  investmentGrants           InvestmentGrant[]
  investmentGrantTransfers   InvestmentGrantTransfer[]
  accountsApprovals          AccountsApproval[]
  simpleModeEntries          SimpleModeEntry[]
  vatReturnFilings           VatReturnFiling[]
  corporateTaxReturns        CorporateTaxReturn[]

  @@index([addressId])
  @@index([headquartersAddressId])
  @@index([archivedAt])
  @@map("companies")
}

model Establishment {
  id                                String    @id @default(cuid())
  companyId                         String
  siret                             String    @unique // SIRET de l'établissement (14 chiffres)
  siren                             String? // SIREN (9 chiffres, extrait du SIRET)
  name                              String? // Nom de l'établissement (ex: "Siège social", "Agence Paris", etc.)
  addressId                         String? // Référence vers l'adresse de l'établissement
  activityCode                      String? // Code APE/NAF de l'établissement
  isMain                            Boolean   @default(false) // Indique si c'est l'établissement principal
  isActive                          Boolean   @default(true) // Indique si l'établissement est actif
  notes                             String? // Notes sur l'établissement
  // Organisme de formation (attribué au SIRET, pas au SIREN)
  isTrainingOrganization            Boolean   @default(false) // Indique si cet établissement est un organisme de formation
  trainingActivityDeclarationNumber String? // Numéro de déclaration d'activité (NDA) délivré par la DIRECCTE pour cet établissement
  trainingActivityDeclarationDate   DateTime? // Date de déclaration d'activité (permet de savoir quand le BPF est requis)
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  // Relations
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address          Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  taxRegimeHistory TaxRegimeHistory[] // Historique des régimes fiscaux pour cet établissement

  @@index([companyId])
  @@index([siret])
  @@index([isMain])
  @@index([addressId])
  @@map("establishments")
}

enum ShareholderType {
  PHYSICAL // Personne physique
  LEGAL // Personne morale
}

model Shareholder {
  id                   String          @id @default(cuid())
  companyId            String // Société dont on est actionnaire
  type                 ShareholderType // Personne physique ou morale
  // For PHYSICAL: use person relation
  // For LEGAL with companyShareholderId: use companyShareholder relation
  // For LEGAL without companyShareholderId: use name and siret
  name                 String? // Raison sociale (pour personne morale non-entreprise uniquement)
  siret                String? // SIRET (pour personne morale non-entreprise uniquement)
  sharePercentage      Decimal         @db.Decimal(5, 2) // Pourcentage de participation (0-100)
  numberOfShares       Int? // Nombre de parts détenues
  capitalAmount        Decimal?        @db.Decimal(15, 2) // Montant du capital détenu (en euros)
  companyShareholderId String? // Si type=LEGAL, référence vers une Company (société actionnaire)
  personId             String? // Si type=PHYSICAL, référence vers une Person (obligatoire)
  notes                String? // Notes optionnelles
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Relations
  company            Company  @relation("CompanyShareholders", fields: [companyId], references: [id], onDelete: Cascade)
  companyShareholder Company? @relation("CompanyAsShareholder", fields: [companyShareholderId], references: [id], onDelete: SetNull)
  person             Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyShareholderId])
  @@index([personId])
  @@map("shareholders")
}

model FiscalYear {
  id           String    @id @default(cuid())
  companyId    String
  year         Int // Année de l'exercice (ex: 2024)
  closingDay   Int? // Jour de clôture (1-31)
  closingMonth Int? // Mois de clôture (1-12)
  startDate    DateTime // Date de début de l'exercice (calculée)
  endDate      DateTime // Date de fin de l'exercice (calculée)
  isClosed     Boolean   @default(false) // Indique si l'exercice est clôturé
  closedAt     DateTime? // Date de la clôture (null tant que l'exercice est ouvert)
  closedById   String? // Utilisateur qui a clôturé l'exercice
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts                 Account[]                 @relation("FiscalYearAccounts")
  accountingEntries        AccountingEntry[]
  fixedAssetDepreciations  FixedAssetDepreciation[]
  budget                   Budget?
  provisionAssessments     ProvisionAssessment[]
  investmentGrantTransfers InvestmentGrantTransfer[]
  accountsApproval         AccountsApproval?
  corporateTaxReturn       CorporateTaxReturn?

  @@unique([companyId, year])
  /// Target of composite foreign keys that keep a child row in the company of its fiscal year (budgets).
  @@unique([id, companyId])
  @@index([companyId])
  @@index([startDate, endDate])
  @@map("fiscal_years")
}

model Account {
  id           String   @id @default(cuid())
  code         String
  label        String
  parentId     String?
  companyId    String
  fiscalYearId String? // Exercice fiscal auquel appartient ce compte
  isPCG        Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  company                     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear                  FiscalYear?  @relation("FiscalYearAccounts", fields: [fiscalYearId], references: [id], onDelete: Cascade)
  parent                      Account?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                    Account[]    @relation("AccountHierarchy")
  entryLines                  EntryLine[]  @relation("AccountEntryLines")
  fixedAssets                 FixedAsset[] @relation("FixedAssetAccount")
  depreciationAccounts        FixedAsset[] @relation("DepreciationAccount")
  depreciationExpenseAccounts FixedAsset[] @relation("DepreciationExpenseAccount")

  @@unique([id, fiscalYearId])
  @@unique([companyId, code, fiscalYearId])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("accounts")
}

model Journal {
  id        String   @id @default(cuid())
  code      String
  label     String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountingEntries AccountingEntry[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("journals")
}

model AccountingEntry {
  id                      String    @id @default(cuid())
  entryNumber             String
  date                    DateTime
  journalId               String
  companyId               String
  fiscalYearId            String // Exercice fiscal de l'écriture (dérivé depuis les comptes des EntryLine)
  description             String?
  reference               String?
  status                  String    @default("draft") // draft, validated
  // Validation makes the entry definitive (PCG art. 1031-3): it receives its
  // number in the fiscal year sequence and can no longer change or be deleted
  // (enforced by database triggers). Drafts carry a provisional "BR-" number.
  validatedAt             DateTime? // FEC ValidDate (LPF art. A47 A-1)
  pieceDate               DateTime? // Date of the supporting document (FEC PieceDate), defaults to the entry date
  // Contre-passation: the reversing entry points to the validated entry it cancels (one reversal per entry).
  reversalOfId            String?   @unique
  // Transaction bancaire dont le rapprochement a créé cette écriture (une seule écriture par transaction).
  // Annuler le rapprochement supprime l'écriture tant qu'elle est en brouillon.
  sourceBankTransactionId String?   @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journal                 Journal                  @relation(fields: [journalId], references: [id], onDelete: NoAction)
  fiscalYear              FiscalYear               @relation(fields: [fiscalYearId], references: [id], onDelete: NoAction)
  sourceBankTransaction   BankTransaction?         @relation("ReconciliationEntry", fields: [sourceBankTransactionId], references: [id], onDelete: SetNull)
  lines                   EntryLine[]              @relation("AccountingEntryLines")
  fixedAssetDepreciations FixedAssetDepreciation[] @relation("FixedAssetDepreciationEntry")
  acquiredFixedAssets     FixedAsset[]             @relation("FixedAssetAcquisitionEntry")
  provisionAssessment     ProvisionAssessment?     @relation("ProvisionAssessmentEntry")
  investmentGrantTransfer InvestmentGrantTransfer? @relation("InvestmentGrantTransferEntry")
  reversalOf              AccountingEntry?         @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: NoAction)
  reversedBy              AccountingEntry?         @relation("EntryReversal")
  invoice                 Invoice?                 @relation("InvoiceEntry")
  expenseReport           ExpenseReport?           @relation("ExpenseReportEntry")
  vatTransfers            InvoicePayment[]         @relation("InvoicePaymentVatTransfer")
  simpleModeEntry         SimpleModeEntry?
  // Tous les comptes d'une écriture doivent appartenir au même exercice fiscal

  @@unique([entryNumber, fiscalYearId])
  @@unique([id, entryNumber])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([date])
  @@index([companyId, date])
  @@map("accounting_entries")
}

model EntryLine {
  id                     String    @id @default(cuid())
  accountingEntryId      String
  accountingEntryNumber  String
  accountId              String
  accountFiscalYearId    String
  debit                  Decimal   @default(0) @db.Decimal(15, 2)
  credit                 Decimal   @default(0) @db.Decimal(15, 2)
  description            String?
  // FEC fields kept as imported or entered (LPF art. A47 A-1): auxiliary
  // (client/supplier) account, lettrage, and foreign currency amount.
  auxiliaryAccountNumber String?
  auxiliaryAccountLabel  String?
  letteringCode          String? // EcritureLet: may change after validation
  letteringDate          DateTime? // DateLet: may change after validation
  currencyAmount         Decimal?  @db.Decimal(15, 2) // Montantdevise
  currencyCode           String? // Idevise (ISO 4217)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  accountingEntry AccountingEntry  @relation("AccountingEntryLines", fields: [accountingEntryId, accountingEntryNumber], references: [id, entryNumber], onDelete: Cascade)
  account         Account          @relation("AccountEntryLines", fields: [accountId, accountFiscalYearId], references: [id, fiscalYearId], onDelete: NoAction)
  invoicePayments InvoicePayment[]

  /// Company of the entry, set by the database (trigger kledg_rls_entry_line_company)
  /// for the row level security policies (docs/rls.md). Never written by the app.
  companyId String? @ignore

  @@index([accountingEntryId])
  @@index([accountId])
  @@index([accountFiscalYearId])
  @@index([accountId, letteringCode])
  @@index([companyId])
  @@map("entry_lines")
}

enum BankingProvider {
  QONTO // Direct API (API key)
  REVOLUT // Revolut Business direct API (OAuth, certificate)
  PONTO // Ponto aggregator (custom integration, other banks)
  MANUAL // No API: statements imported from files
}

enum IntegrationType {
  BANKING // Qonto, Revolut, N26, etc.
  STORAGE // Google Drive, Dropbox, etc.
  ACCOUNTING // Sage, Cegid, etc.
  CRM // Salesforce, HubSpot, etc.
  ECOMMERCE // Shopify, WooCommerce, etc.
}

enum IntegrationProvider {
  QONTO
  REVOLUT
  // Unused legacy values: kept because removing a PostgreSQL enum value needs
  // a destructive type rebuild. No code creates them.
  N26
  GOOGLE_DRIVE
  DROPBOX
  PONTO
}

enum IntegrationFeature {
  BANKING_TRANSACTIONS // Transactions bancaires
  BANKING_ACCOUNTS // Comptes bancaires
}

enum AuthenticationType {
  API_KEY // Login + Secret Key (Qonto)
  OAUTH2 // OAuth 2.0 (Google Drive)
  BASIC_AUTH // Basic Authentication
  CUSTOM // Autres méthodes
}

model BankConnection {
  id                 String          @id @default(cuid())
  companyId          String
  provider           BankingProvider @default(QONTO)
  // Legacy Qonto credentials (new connections keep their credentials on Integration)
  login              String          @default("")
  secretKeyEncrypted String          @default("")
  // Integration holding the credentials of this connection (none for MANUAL)
  integrationId      String?         @unique
  selectedAccountId  String? // ID du compte bancaire sélectionné
  lastSyncAt         DateTime?
  lastSyncAttemptAt  DateTime?
  lastSyncError      String?
  // Last refresh requested by a user (Ponto allows one every 5 minutes)
  lastManualSyncAt   DateTime?
  // Earliest consent expiry of the connection (PSD2 access to renew at the bank)
  consentExpiresAt   DateTime?
  status             String          @default("active") // active, inactive, error
  // Données spécifiques au provider (pour stocker des infos additionnelles)
  providerData       Json? // Ex: pour Qonto, peut contenir organization slug, etc.
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relations
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration         Integration?         @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  bankAccounts        BankAccount[]
  transactionMappings TransactionMapping[]
  selectedAccount     BankAccount?         @relation("SelectedBankAccount", fields: [selectedAccountId], references: [id], onDelete: SetNull)

  @@unique([companyId, provider])
  @@index([companyId])
  @@index([provider])
  @@map("bank_connections")
}

model BankAccount {
  id                    String    @id @default(cuid())
  bankConnectionId      String
  integrationResourceId String?   @unique // Lien vers IntegrationResource pour rétrocompatibilité
  externalAccountId     String // ID du compte dans le système externe (ex: IBAN pour Qonto, account_id pour Revolut)
  iban                  String? // IBAN si disponible
  name                  String
  displayName           String? // Nom d'affichage personnalisé (plus simple que le nom complet)
  balance               Decimal   @default(0) @db.Decimal(15, 2)
  currency              String    @default("EUR")
  shouldSync            Boolean   @default(true) // Indique si ce compte doit être synchronisé
  // Ledger account (512xxx code, resolved against the active fiscal year)
  ledgerAccountCode     String?
  // Consent expiry reported by the provider for this account
  consentExpiresAt      DateTime?
  lastSyncedAt          DateTime?
  lastSyncError         String?
  // Set when a direct connection (Qonto, Revolut) covers the same IBAN: this
  // aggregator account then stops syncing
  supersededById        String?
  // Données spécifiques au provider (pour stocker des infos additionnelles)
  providerData          Json? // Ex: pour Qonto, peut contenir slug, bic, etc.
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  bankConnection      BankConnection         @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  supersededBy        BankAccount?           @relation("SupersededBankAccount", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes          BankAccount[]          @relation("SupersededBankAccount")
  integrationResource IntegrationResource?   @relation("BankAccountIntegrationResource", fields: [integrationResourceId], references: [id], onDelete: SetNull)
  transactions        BankTransaction[]
  selectedIn          BankConnection[]       @relation("SelectedBankAccount")
  transactionMatches  BankTransactionMatch[]

  @@unique([bankConnectionId, externalAccountId])
  @@index([bankConnectionId])
  @@index([shouldSync])
  @@index([iban])
  @@index([integrationResourceId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                    String    @id @default(cuid())
  bankAccountId         String
  externalTransactionId String // ID de la transaction dans le système externe
  amount                Decimal   @db.Decimal(15, 2)
  date                  DateTime
  label                 String?
  reference             String?
  side                  String // debit, credit
  note                  String?
  imported              Boolean   @default(false)
  reconciled            Boolean   @default(false) // Indique si la transaction est rapprochée
  reconciledAt          DateTime? // Date de rapprochement
  reconciledWith        String? // ID de l'écriture comptable avec laquelle elle est rapprochée
  // Champs enrichis depuis Qonto (extraits de providerData pour faciliter l'accès)
  logoUrl               String? // URL du logo du contrepartie (Qonto)
  counterpartyName      String? // Nom nettoyé du contrepartie (Qonto clean_counterparty_name)
  category              String? // Catégorie de la transaction (Qonto category)
  cashflowCategory      String? // Catégorie de flux de trésorerie (Qonto cashflow_category.name)
  cashflowSubcategory   String? // Sous-catégorie de flux de trésorerie (Qonto cashflow_subcategory.name)
  operationType         String? // Type d'opération (Qonto operation_type: card, transfer, etc.)
  // TVA détectée automatiquement par Qonto (pour le rapprochement)
  vatRate               Decimal?  @db.Decimal(5, 2) // Taux de TVA (ex: 20.00)
  vatAmount             Decimal?  @db.Decimal(15, 2) // Montant de TVA en euros
  // Statut Qonto : completed, pending, declined (persisté pour affichage et règles)
  status                String? // completed = vérifiée, pending = en attente, declined = refusée
  // Données spécifiques au provider (pour stocker des infos additionnelles)
  providerData          Json? // Ex: pour Qonto, peut contenir operation_type, etc.
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  bankAccount         BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  attachments         Attachment[]
  reconciliationEntry AccountingEntry?      @relation("ReconciliationEntry")
  syncMatch           BankTransactionMatch?
  simpleModeEntries   SimpleModeEntry[]

  /// Company of the bank account's connection, set by the database (trigger
  /// kledg_rls_bank_transaction_company) for the row level security policies
  /// (docs/rls.md). Never written by the app.
  companyId String? @ignore

  @@unique([bankAccountId, externalTransactionId])
  @@index([bankAccountId])
  @@index([date])
  @@index([reconciled])
  @@index([bankAccountId, date])
  @@index([companyId])
  @@map("bank_transactions")
}

// A line read from a bank API that was not inserted because the account
// already holds the same operation from another source: a statement file
// imported before, or the aggregator (Ponto) account a direct connection
// replaced for the same IBAN (lib/integrations/sync.ts). Recording it keeps
// a retried sync from inserting the line again; one transaction stands for
// at most one provider line, so identical operations stay distinct.
model BankTransactionMatch {
  id                    String   @id @default(cuid())
  // Account being synced, and the provider id of the line not inserted
  bankAccountId         String
  externalTransactionId String
  // Existing transaction the provider line duplicates (same or superseded account)
  bankTransactionId     String   @unique
  createdAt             DateTime @default(now())

  bankAccount     BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, externalTransactionId])
  @@map("bank_transaction_matches")
}

model TransactionRule {
  id                    String    @id @default(cuid())
  companyId             String
  name                  String // Nom de la règle
  description           String? // Description de la règle
  enabled               Boolean   @default(true)
  priority              Int       @default(0) // Priorité d'application (plus élevé = appliqué en premier)
  // Configuration de l'écriture comptable (Template)
  journalCode           String    @default("BQ") // Code du journal (BQ par défaut)
  defaultVatAccountCode String? // Code PCG du compte de TVA par défaut (résolu contre l'exercice actif au moment de l'application)
  // Configuration spécifique
  autoCreate            Boolean   @default(false) // Applied by the refresh without a click; otherwise a suggestion (lib/transactions/rule-matcher.ts)
  // Unused since rule entries are always drafts validated by a person; kept for released databases (additive migrations only)
  requireApproval       Boolean   @default(true)
  // Métadonnées
  usageCount            Int       @default(0) // Nombre de fois que la règle a été utilisée
  lastUsedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company    Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conditions TransactionRuleCondition[]
  entryLines TransactionRuleEntryLine[]

  @@index([companyId])
  @@index([enabled])
  @@index([priority])
  @@map("transaction_rules")
}

model TransactionRuleCondition {
  id            String  @id @default(cuid())
  ruleId        String
  conditionType String // 'label', 'reference', 'amount', 'counterparty', 'category', 'cashflowCategory', 'cashflowSubcategory', 'operationType', 'side'
  operator      String // 'equals', 'contains', 'startsWith', 'regex', 'gt', 'lt', 'between', 'gte', 'lte'
  value         String? // Valeur à comparer
  value2        String? // Deuxième valeur pour 'between'

  rule TransactionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([conditionType])
  @@map("transaction_rule_conditions")
}

model TransactionRuleEntryLine {
  id              String   @id @default(cuid())
  ruleId          String
  accountCode     String // Code PCG du compte (résolu contre l'exercice actif à l'application)
  lineType        String // 'debit', 'credit', 'auto' (auto selon side de transaction)
  amountType      String // 'full', 'percentage', 'fixed', 'remaining', 'ht', 'ttc', 'vat'
  amountValue     Decimal? @db.Decimal(15, 2) // Pourcentage ou montant fixe
  description     String?
  order           Int // Ordre d'affichage/création
  // Support TVA avancé
  vatType         String? // 'none', 'collectible', 'deductible', 'intracom', 'import', 'exempt', 'reverse_charge'
  vatRateSource   String?  @default("fixed") // 'fixed' = taux saisi, 'transaction' = taux/montant détecté (ex. Qonto)
  vatRate         Decimal? @db.Decimal(5, 2) // Taux de TVA (20.00, 10.00, 5.50) - utilisé si vatRateSource = 'fixed'
  vatAccountCode  String? // Code PCG du compte de TVA (ex. 445662 intracom, 44566 import)
  vatAccount2Code String? // Code PCG du deuxième compte TVA (ex. 4452 intracom) - sens selon contexte achat/vente
  vatOnDebit      Boolean  @default(false) // TVA sur débit (vs encaissement) - pour les avoirs clients

  rule TransactionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([order])
  @@map("transaction_rule_entry_lines")
}

model TransactionMapping {
  id                     String   @id @default(cuid())
  bankConnectionId       String
  defaultDebitAccountId  String?
  defaultCreditAccountId String?
  rules                  Json? // Règles avancées de mapping
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  @@unique([bankConnectionId])
  @@index([bankConnectionId])
  @@map("transaction_mappings")
}

model Integration {
  id                   String              @id @default(cuid())
  companyId            String
  provider             IntegrationProvider
  type                 IntegrationType
  name                 String // Nom personnalisé de l'intégration
  status               String              @default("active") // active, inactive, error
  lastSyncAt           DateTime?
  // Credentials stockés de manière flexible selon le type d'auth
  credentials          Json // { login, secretKey } pour API_KEY, { accessToken, refreshToken } pour OAUTH2, etc.
  credentialsEncrypted Boolean             @default(false) // Indique si les credentials sont chiffrés
  // Configuration de l'intégration
  config               Json? // Configuration spécifique (comptes sélectionnés, dossiers, etc.)
  // Métadonnées
  metadata             Json? // Données additionnelles du provider
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Relations
  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  featureConfigs IntegrationFeatureConfig[] @relation("IntegrationFeatures")
  resources      IntegrationResource[]
  syncLogs       IntegrationSyncLog[]
  attachments    Attachment[]
  bankConnection BankConnection?

  @@index([companyId])
  @@index([provider])
  @@index([type])
  @@index([status])
  @@map("integrations")
}

model IntegrationFeatureConfig {
  id            String             @id @default(cuid())
  integrationId String
  feature       IntegrationFeature // Enum IntegrationFeature
  enabled       Boolean            @default(true)
  config        Json? // Configuration spécifique à la feature
  lastSyncAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  integration Integration @relation("IntegrationFeatures", fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, feature])
  @@index([integrationId])
  @@map("integration_features")
}

model IntegrationResource {
  id            String   @id @default(cuid())
  integrationId String
  resourceType  String // "bank_account", "file", "folder", "contact", etc.
  externalId    String // ID dans le système externe
  name          String
  // Données spécifiques selon le type de ressource
  data          Json // { iban, balance } pour bank_account, { path, size } pour file, etc.
  metadata      Json? // Métadonnées additionnelles
  shouldSync    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  integration Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation("BankAccountIntegrationResource")

  @@unique([integrationId, resourceType, externalId])
  @@index([integrationId])
  @@index([resourceType])
  @@index([shouldSync])
  @@map("integration_resources")
}

model IntegrationSyncLog {
  id            String              @id @default(cuid())
  integrationId String
  feature       IntegrationFeature? // Enum IntegrationFeature
  status        String // success, error, partial
  itemsSynced   Int                 @default(0)
  errors        Json? // Liste des erreurs
  startedAt     DateTime
  completedAt   DateTime?
  createdAt     DateTime            @default(now())

  // Relations
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([startedAt])
  @@map("integration_sync_logs")
}

model ImportJob {
  id        String   @id @default(cuid())
  companyId String
  type      String // fec, csv, excel
  fileName  String
  status    String   @default("pending") // pending, processing, completed, failed
  errors    Json?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("import_jobs")
}

model ImportMapping {
  id           String   @id @default(cuid())
  importJobId  String?
  sourceColumn String
  targetField  String
  createdAt    DateTime @default(now())
