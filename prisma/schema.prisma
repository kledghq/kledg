model FixedAsset {
  id                    String    @id @default(cuid())
  companyId             String
  label                 String // Libellé de l'immobilisation
  comment               String? // Commentaire
  acquisitionDate       DateTime // Date d'acquisition
  acquisitionValue      Decimal   @db.Decimal(15, 2) // Valeur d'acquisition (HT)
  amortizableAmount     Decimal?  @db.Decimal(15, 2) // Montant amortissable (peut être différent de acquisitionValue)
  disposalDate          DateTime? // Date de cession
  depreciationRate      Decimal?  @db.Decimal(5, 2) // Taux d'amortissement annuel (%)
  depreciationDuration  Int? // Durée d'amortissement en années
  depreciationMethod    String    @default("linear") // linear, declining
  decliningCoefficient  Decimal?  @db.Decimal(5, 2) // Coefficient dégressif (ex: 1.25, 1.75, 2.25)
  depreciationStartDate DateTime // Date de début d'amortissement
  assetAccountId        String // Compte d'actif (ex: 211)
  depreciationAccountId String // Compte d'amortissement (ex: 281)
  expenseAccountId      String // Compte de charge d'amortissement (ex: 681)
  isActive              Boolean   @default(true) // Indique si l'immobilisation est active
  isFullyPaid           Boolean   @default(false) // Indique si l'immobilisation est entièrement payée
  /// Entry that booked the acquisition, when Kledg created the asset with it
  /// (simple mode, durable equipment). The asset goes with that entry: deleting
  /// the draft deletes the asset first (deleteFixedAssetsAcquiredByEntryInTx),
  /// and NO ACTION refuses any other path that would leave the asset behind.
  acquisitionEntryId    String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  acquisitionEntry    AccountingEntry?         @relation("FixedAssetAcquisitionEntry", fields: [acquisitionEntryId], references: [id], onDelete: NoAction)
  simpleModeEntry     SimpleModeEntry?
  assetAccount        Account                  @relation("FixedAssetAccount", fields: [assetAccountId], references: [id], onDelete: NoAction)
  depreciationAccount Account                  @relation("DepreciationAccount", fields: [depreciationAccountId], references: [id], onDelete: NoAction)
  expenseAccount      Account                  @relation("DepreciationExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: NoAction)
  depreciations       FixedAssetDepreciation[]
  provisions          Provision[]
  investmentGrants    InvestmentGrant[]

  @@index([companyId])
  @@index([acquisitionEntryId])
  @@map("fixed_assets")
}

/// Enregistrement d'amortissement saisi par l'utilisateur.
/// PAS une écriture comptable, juste la valeur amortie pour un exercice
/// (ou un mois précis) d'une immobilisation donnée. Les stats, la VNC
/// et le "déjà amorti" s'en déduisent.
model FixedAssetDepreciation {
  id                String   @id @default(cuid())
  companyId         String
  fixedAssetId      String
  fiscalYearId      String
  periodType        String // 'year' ou 'month'
  monthIndex        Int? // 0-11 si periodType=month, sinon null
  year              Int // année calendaire pratique pour périodes à cheval sur 2 FY
  amount            Decimal  @db.Decimal(15, 2)
  note              String?
  /// Écriture comptable liée (optionnelle). L'amortissement n'en crée pas
  /// automatiquement ; ce lien est posé si l'utilisateur rattache une
  /// écriture existante ou génère une dotation depuis ce record.
  accountingEntryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fixedAsset      FixedAsset       @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
  fiscalYear      FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  accountingEntry AccountingEntry? @relation("FixedAssetDepreciationEntry", fields: [accountingEntryId], references: [id], onDelete: SetNull)

  // Un seul record par période pour une immo donnée.
  @@unique([fixedAssetId, fiscalYearId, periodType, monthIndex])
  @@index([companyId])
  @@index([fixedAssetId])
  @@index([fiscalYearId])
  @@index([accountingEntryId])
  @@map("fixed_asset_depreciations")
}

model TaxRegimeHistory {
  id              String    @id @default(cuid())
  companyId       String
  regimeType      String // vat, corporateTax
  regime          String // normal, simplified, franchise, real, micro
  startDate       DateTime // Date de début d'application du régime
  endDate         DateTime? // Date de fin d'application (null si toujours actif)
  notes           String? // Notes optionnelles
  // Exonération de TVA (pour les organismes de formation)
  isVatExempt     Boolean   @default(false) // Indique si ce régime inclut une exonération de TVA
  vatExemptReason String? // Raison de l'exonération (ex: "organisme de formation")
  establishmentId String? // ID de l'établissement concerné par l'exonération (null = tous les établissements)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([regimeType])
  @@index([startDate, endDate])
  @@index([establishmentId])
  @@map("tax_regime_history")
}

enum AuditLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// Append-only: UPDATE and DELETE are refused by the trigger of migration
/// 20261011090000_audit_log_append_only (rows older than 10 years can be purged
/// with kledg_purge_audit_logs only).
model AuditLog {
  id        String        @id @default(cuid())
  userId    String? // User ID from Supabase (email or UUID)
  action    String? // Action type (e.g., "CREATE_ACCOUNT", "UPDATE_TRANSACTION")
  level     AuditLogLevel @default(INFO)
  message   String
  metadata  Json? // Additional context data
  companyId String? // Optional: company context
  ipAddress String? // Optional: IP address
  userAgent String? // Optional: User agent
  createdAt DateTime      @default(now())

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([level])
  @@index([createdAt])
  @@map("audit_logs")
}

// Person: physical person, shareholder of a company

model Person {
  id              String    @id @default(cuid())
  firstName       String
  name            String
  email           String?
  phone           String?
  photo           String? // Photo en base64 (comme le logo des entreprises)
  addressId       String? // Référence vers l'adresse de la personne
  notes           String?
  // Informations de naissance pour les déclarations fiscales (formulaire 2033-F-SD)
  birthDate       DateTime? // Date de naissance
  birthDepartment String? // Numéro de département de naissance
  birthCity       String? // Commune de naissance
  birthCountry    String?   @default("FR") // Pays de naissance (code ISO, ex: "FR")
  usualName       String? // Nom d'usage (si différent du nom de naissance)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  address          Address?          @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shareholders     Shareholder[] // Link to shareholders (type PHYSICAL)
  expenseClaimants ExpenseClaimant[]
  company          Company?          @relation(fields: [companyId], references: [id])
  companyId        String?

  @@unique([companyId, email])
  @@index([email])
  @@index([name, firstName])
  @@index([addressId])
  @@map("persons")
}

// Modèle pour stocker les justificatifs (attachments) liés aux transactions bancaires

model Attachment {
  id                   String   @id @default(cuid())
  companyId            String
  integrationId        String? // Intégration source (Qonto, etc.)
  bankTransactionId    String? // Transaction bancaire associée
  externalAttachmentId String?  @unique // ID de l'attachment dans le système externe (Qonto)
  transactionUuid      String? // UUID de la transaction dans le système externe (pour Qonto)
  // Informations sur le fichier
  fileName             String
  fileSize             Int? // Taille en octets
  fileContentType      String? // Type MIME (ex: application/pdf, image/jpeg)
  fileUrl              String? // URL du fichier (peut être temporaire)
  // Données brutes du provider externe
  providerData         Json? // Données spécifiques au provider (ex: Qonto probative_attachment)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration     Integration?     @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  expenseLines    ExpenseLine[]

  @@unique([integrationId, externalAttachmentId])
  @@index([companyId])
  @@index([integrationId])
  @@index([bankTransactionId])
  @@index([transactionUuid])
  @@map("attachments")
}

// Configuration des lignes de bilan

model BalanceSheetLineConfig {
  id                        String   @id @default(cuid())
  companyId                 String
  reportVariant             String   @default("complete") // 'complete' | 'simplified'
  parentId                  String? // Parent line ID for nested structure (null for root lines)
  section                   String? // 'actif' | 'passif' - Explicit section for easy sorting
  lineLabel                 String // Display label
  lineType                  String   @default("line") // 'group' | 'sum' | 'line' - Group (organisation), Sum (somme des enfants), Line (avec comptes)
  formCode                  String? // Form code from official forms (e.g., "010", "120") - for Brut column
  amortissementFormCode     String? // Form code for Amortissements column (e.g., "AC", "CQ")
  accountCodes              String[] // Account codes to include (vide pour les groupes)
  excludedAccountCodes      String[] @default([]) // Account codes to exclude
  amortissementAccountCodes String[] @default([]) // Account codes for amortissement column (28xx, 29xx, 39xx, etc.)
  filterType                String? // 'starts_with' | 'exact' | 'range' | 'custom'
  filterValue               String? // Additional filter value
  balanceType               String // 'debit' | 'credit' | 'auto'
  displayType               String   @default("net") // 'net' | 'brut_amort_net' - Type d'affichage pour l'actif
  hideLabel                 Boolean  @default(false) // Hide the label for this line (useful for groups)
  order                     Int // Display order
  notes                     String? // Notes and annotations for this line
  version                   Int      @default(1) // Version number for history tracking
  templateId                String? // Reference to template if created from template
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company  Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   BalanceSheetLineConfig?     @relation("BalanceSheetLineConfigHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children BalanceSheetLineConfig[]    @relation("BalanceSheetLineConfigHierarchy")
  history  BalanceSheetConfigHistory[]

  @@unique([companyId, reportVariant, id, version])
  @@index([companyId, reportVariant])
  @@index([parentId])
  @@index([templateId])
  @@map("balance_sheet_line_configs")
}

